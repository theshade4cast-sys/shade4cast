{% comment %}
  Announcement bar section
{% endcomment %}

{% if section.blocks.size > 0 %}
  <div class="announcement-bar">
    <div class="container">
      <div class="announcement-bar__content">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'announcement' %}
              <div class="announcement" {{ block.shopify_attributes }}>
                {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}" class="announcement__link">
                    {{ block.settings.text }}
                  </a>
                {% else %}
                  <span class="announcement__text">{{ block.settings.text }}</span>
                {% endif %}
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

<style>
  .announcement-bar {
    background-color: var(--color-base-accent-1);
    color: var(--color-base-background-1);
    padding: 1rem 0;
    text-align: center;
    font-size: 1.4rem;
    position: relative;
    z-index: 10;
  }
  
  .announcement-bar__content {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .announcement {
    padding: 0.5rem 1rem;
  }
  
  .announcement__link,
  .announcement__text {
    color: var(--color-base-background-1);
    text-decoration: none;
    font-weight: 500;
  }
  
  .announcement__link:hover {
    text-decoration: underline;
  }
  
  @media screen and (max-width: 749px) {
    .announcement-bar {
      font-size: 1.3rem;
    }
  }
</style>

{% schema %}
{
  "name": "Announcement Bar",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Welcome to our store"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Welcome to The Shade 4cast - Your #1 destination for political commentary!"
          }
        }
      ]
    }
  ]
}
{% endschema %}