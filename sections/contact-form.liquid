{% comment %}
  Contact form section
{% endcomment %}

<section class="section">
  <div class="container">
    {% if section.settings.title != blank %}
      <div class="section-header">
        <h2>{{ section.settings.title }}</h2>
        {% if section.settings.subtitle != blank %}
          <p>{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}
    
    <div class="contact-section">
      <div class="grid grid--2-col">
        <div class="contact-form">
          {% form 'contact' %}
            {% if form.posted_successfully? %}
              <div class="form-status form-status--success">
                <h3>{{ section.settings.success_title | default: "Thank you!" }}</h3>
                <p>{{ section.settings.success_message | default: "Your message has been sent successfully. We'll get back to you soon!" }}</p>
              </div>
            {% endif %}
            
            {% if form.errors %}
              <div class="form-status form-status--error">
                <h3>{{ section.settings.error_title | default: "Please correct the following:" }}</h3>
                <ul>
                  {% for field in form.errors %}
                    <li>{{ field | capitalize }} {{ form.errors.messages[field] }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
            
            <div class="form-group">
              <label for="ContactFormName" class="form-label">
                {{ section.settings.name_label | default: "Name" }} *
              </label>
              <input type="text" 
                     id="ContactFormName" 
                     name="contact[name]" 
                     class="form-input"
                     value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                     required>
            </div>
            
            <div class="form-group">
              <label for="ContactFormEmail" class="form-label">
                {{ section.settings.email_label | default: "Email" }} *
              </label>
              <input type="email" 
                     id="ContactFormEmail" 
                     name="contact[email]" 
                     class="form-input"
                     value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                     required>
            </div>
            
            <div class="form-group">
              <label for="ContactFormPhone" class="form-label">
                {{ section.settings.phone_label | default: "Phone" }}
              </label>
              <input type="tel" 
                     id="ContactFormPhone" 
                     name="contact[phone]" 
                     class="form-input"
                     value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}">
            </div>
            
            <div class="form-group">
              <label for="ContactFormMessage" class="form-label">
                {{ section.settings.message_label | default: "Message" }} *
              </label>
              <textarea id="ContactFormMessage" 
                        name="contact[body]" 
                        class="form-textarea"
                        rows="5"
                        placeholder="{{ section.settings.message_placeholder | default: 'Tell us what\'s on your mind...' }}"
                        required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
            </div>
            
            <div class="form-group">
              <button type="submit" class="btn btn--large">
                {{ section.settings.submit_text | default: "Send Message" }}
              </button>
            </div>
          {% endform %}
        </div>
        
        <div class="contact-info">
          {% if section.settings.info_title != blank %}
            <h3 class="contact-info__title">{{ section.settings.info_title }}</h3>
          {% endif %}
          
          {% if section.settings.info_text != blank %}
            <div class="contact-info__text">
              {{ section.settings.info_text }}
            </div>
          {% endif %}
          
          <div class="contact-info__details">
            {% if section.settings.email != blank %}
              <div class="contact-detail">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.89 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                </svg>
                <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
              </div>
            {% endif %}
            
            {% if section.settings.phone != blank %}
              <div class="contact-detail">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                </svg>
                <a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '-', '' }}">{{ section.settings.phone }}</a>
              </div>
            {% endif %}
            
            {% if section.settings.address != blank %}
              <div class="contact-detail">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span>{{ section.settings.address }}</span>
              </div>
            {% endif %}
          </div>
          
          {% if section.settings.show_social_links %}
            <div class="contact-social">
              <h4>Follow Us</h4>
              <div class="social-icons">
                {% if settings.social_youtube_link != blank %}
                  <a href="{{ settings.social_youtube_link }}" class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                    </svg>
                  </a>
                {% endif %}
                
                {% if settings.social_twitter_link != blank %}
                  <a href="{{ settings.social_twitter_link }}" class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                    </svg>
                  </a>
                {% endif %}
                
                {% if settings.social_instagram_link != blank %}
                  <a href="{{ settings.social_instagram_link }}" class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                  </a>
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    max-width: 120rem;
    margin: 0 auto;
  }
  
  .contact-form {
    padding-right: 2rem;
  }
  
  .form-group {
    margin-bottom: 2rem;
  }
  
  .form-label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
    color: var(--color-base-text);
  }
  
  .form-input,
  .form-textarea {
    width: 100%;
    padding: 1.2rem 1.6rem;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: var(--inputs-radius);
    font-size: 1.6rem;
    font-family: inherit;
    background-color: var(--color-base-background-1);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  
  .form-input:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--color-base-accent-1);
    box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.1);
  }
  
  .form-textarea {
    resize: vertical;
    min-height: 12rem;
  }
  
  .form-status {
    padding: 2rem;
    border-radius: var(--inputs-radius);
    margin-bottom: 3rem;
  }
  
  .form-status--success {
    background-color: #f0fdf4;
    border: 1px solid #10b981;
    color: #065f46;
  }
  
  .form-status--error {
    background-color: #fef2f2;
    border: 1px solid #ef4444;
    color: #991b1b;
  }
  
  .form-status h3 {
    margin-bottom: 1rem;
    font-size: 1.8rem;
  }
  
  .form-status ul {
    margin: 0;
    padding-left: 2rem;
  }
  
  .contact-info {
    padding-left: 2rem;
  }
  
  .contact-info__title {
    font-size: 2.4rem;
    margin-bottom: 2rem;
  }
  
  .contact-info__text {
    font-size: 1.6rem;
    line-height: 1.6;
    color: var(--color-base-accent-2);
    margin-bottom: 3rem;
  }
  
  .contact-info__details {
    margin-bottom: 3rem;
  }
  
  .contact-detail {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    font-size: 1.6rem;
  }
  
  .contact-detail svg {
    color: var(--color-base-accent-2);
    flex-shrink: 0;
  }
  
  .contact-detail a {
    color: var(--color-base-text);
    text-decoration: none;
  }
  
  .contact-detail a:hover {
    color: var(--color-base-accent-1);
    text-decoration: underline;
  }
  
  .contact-social h4 {
    margin-bottom: 1.5rem;
    font-size: 1.8rem;
  }
  
  .contact-social .social-icons {
    justify-content: flex-start;
  }
  
  .contact-social .social-icon {
    color: var(--color-base-accent-2);
  }
  
  .contact-social .social-icon:hover {
    color: var(--color-base-accent-1);
  }
  
  @media screen and (max-width: 749px) {
    .contact-section .grid--2-col {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
    
    .contact-form,
    .contact-info {
      padding-left: 0;
      padding-right: 0;
    }
  }
</style>

{% schema %}
{
  "name": "Contact Form",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section settings"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Get in Touch"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section subtitle"
    },
    {
      "type": "header",
      "content": "Form labels"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name field label",
      "default": "Name"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email field label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone field label",
      "default": "Phone"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message field label",
      "default": "Message"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "Message placeholder",
      "default": "Tell us what's on your mind..."
    },
    {
      "type": "text",
      "id": "submit_text",
      "label": "Submit button text",
      "default": "Send Message"
    },
    {
      "type": "header",
      "content": "Success/Error messages"
    },
    {
      "type": "text",
      "id": "success_title",
      "label": "Success title",
      "default": "Thank you!"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Your message has been sent successfully. We'll get back to you soon!"
    },
    {
      "type": "text",
      "id": "error_title",
      "label": "Error title",
      "default": "Please correct the following:"
    },
    {
      "type": "header",
      "content": "Contact information"
    },
    {
      "type": "text",
      "id": "info_title",
      "label": "Contact info title",
      "default": "Let's Connect"
    },
    {
      "type": "richtext",
      "id": "info_text",
      "label": "Contact info text"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address"
    },
    {
      "type": "checkbox",
      "id": "show_social_links",
      "label": "Show social media links",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}