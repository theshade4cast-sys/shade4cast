{% comment %}
  Featured Videos section for displaying latest YouTube videos
{% endcomment %}

<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>{{ section.settings.title | default: "Latest Videos" }}</h2>
      {% if section.settings.subtitle != blank %}
        <p>{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>
    
    <div class="featured-videos">
      {% if section.blocks.size > 0 %}
        <div class="grid grid--3-col">
          {% for block in section.blocks limit: 6 %}
            {% case block.type %}
              {% when 'video' %}
                <div class="video-card" {{ block.shopify_attributes }}>
                  {% if block.settings.video_url != blank %}
                    <div class="video-embed" data-aspect-ratio="16:9">
                      {% assign video_id = block.settings.video_url | split: '=' | last %}
                      <iframe src="https://www.youtube.com/embed/{{ video_id }}" 
                              frameborder="0" 
                              allowfullscreen
                              loading="lazy">
                      </iframe>
                    </div>
                  {% endif %}
                  
                  <div class="video-card__content">
                    {% if block.settings.title != blank %}
                      <h3 class="video-card__title">{{ block.settings.title }}</h3>
                    {% endif %}
                    
                    {% if block.settings.description != blank %}
                      <p class="video-card__description">{{ block.settings.description }}</p>
                    {% endif %}
                    
                    {% if block.settings.date != blank %}
                      <p class="video-card__date">{{ block.settings.date | date: '%B %d, %Y' }}</p>
                    {% endif %}
                    
                    {% if block.settings.video_url != blank %}
                      <a href="{{ block.settings.video_url }}" 
                         target="_blank" 
                         rel="noopener noreferrer"
                         class="video-card__link">
                        Watch on YouTube
                      </a>
                    {% endif %}
                  </div>
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      {% else %}
        <div class="placeholder-videos">
          <div class="grid grid--3-col">
            {% for i in (1..3) %}
              <div class="video-card">
                <div class="video-embed placeholder-video">
                  <div class="placeholder-content">
                    <svg width="60" height="60" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                    <p>Video {{ i }}</p>
                  </div>
                </div>
                <div class="video-card__content">
                  <h3 class="video-card__title">Sample Video Title {{ i }}</h3>
                  <p class="video-card__description">This is a sample video description showing how your content will look.</p>
                  <p class="video-card__date">{{ 'now' | date: '%B %d, %Y' }}</p>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
    
    {% if section.settings.view_all_url != blank %}
      <div class="text-center mt-4">
        <a href="{{ section.settings.view_all_url }}" class="btn btn--secondary">
          View All Videos
        </a>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .featured-videos {
    margin-bottom: 4rem;
  }
  
  .video-card {
    background-color: var(--color-base-background-1);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: var(--media-radius);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .video-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }
  
  .video-embed {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    overflow: hidden;
  }
  
  .video-embed iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  
  .placeholder-video {
    background-color: var(--color-base-background-2);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .placeholder-content {
    text-align: center;
    color: var(--color-base-accent-2);
  }
  
  .placeholder-content svg {
    margin-bottom: 1rem;
  }
  
  .video-card__content {
    padding: 2rem;
  }
  
  .video-card__title {
    font-size: 1.8rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  
  .video-card__description {
    color: var(--color-base-accent-2);
    margin-bottom: 1rem;
    line-height: 1.5;
  }
  
  .video-card__date {
    font-size: 1.4rem;
    color: var(--color-base-accent-2);
    margin-bottom: 1.5rem;
  }
  
  .video-card__link {
    display: inline-block;
    font-weight: 600;
    color: var(--color-link);
    text-decoration: none;
    transition: color 0.3s ease;
  }
  
  .video-card__link:hover {
    color: var(--color-link-hover);
    text-decoration: underline;
  }
</style>

{% schema %}
{
  "name": "Featured Videos",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Latest Videos"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section subtitle"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all videos URL"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Video title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Video description"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "YouTube video URL"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Published date (YYYY-MM-DD)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Videos"
    }
  ]
}
{% endschema %}