{% comment %}
  Footer section for The Shade 4cast theme
{% endcomment %}

<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer__content">
      <div class="footer__section">
        <h3>{{ section.settings.about_title | default: "About The Shade 4cast" }}</h3>
        <p>{{ section.settings.about_text | default: "Your go-to 4-person panel talk show covering politics and hot topics with insight, humor, and a whole lot of shade." }}</p>
        
        {% if section.settings.show_social_icons %}
          <div class="social-icons">
            {% if section.settings.youtube_url != blank %}
              <a href="{{ section.settings.youtube_url }}" class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              </a>
            {% endif %}
            
            {% if section.settings.twitter_url != blank %}
              <a href="{{ section.settings.twitter_url }}" class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                </svg>
              </a>
            {% endif %}
            
            {% if section.settings.instagram_url != blank %}
              <a href="{{ section.settings.instagram_url }}" class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </a>
            {% endif %}
            
            {% if section.settings.facebook_url != blank %}
              <a href="{{ section.settings.facebook_url }}" class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
      
      <div class="footer__section">
        <h3>Quick Links</h3>
        <nav role="navigation" aria-label="Footer navigation">
          <a href="{{ routes.root_url }}">Home</a>
          <a href="{{ pages.about.url | default: '/pages/about' }}">About</a>
          <a href="{{ pages.videos.url | default: '/pages/videos' }}">Latest Videos</a>
          <a href="{{ collections.merchandise.url | default: '/collections/merchandise' }}">Merch</a>
          <a href="{{ blog.shady-topics.url | default: '/blogs/shady-topics' }}">Shady Topics</a>
          <a href="{{ pages.contact.url | default: '/pages/contact' }}">Contact</a>
        </nav>
      </div>
      
      <div class="footer__section">
        <h3>{{ section.settings.newsletter_title | default: "Stay in the Loop" }}</h3>
        <p>{{ section.settings.newsletter_text | default: "Subscribe to our newsletter for the latest updates and behind-the-scenes content." }}</p>
        
        <form class="newsletter__form footer-newsletter" action="#" method="post">
          <input type="email" 
                 class="newsletter__input" 
                 placeholder="Your email address" 
                 required>
          <button type="submit" class="btn">Subscribe</button>
        </form>
      </div>
    </div>
    
    <div class="footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      
      {% if section.settings.show_payment_icons %}
        <div class="payment-icons">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-base-accent-1);
    color: var(--color-base-background-1);
    padding: 4rem 0 2rem;
  }
  
  .footer__content {
    display: grid;
    gap: 3rem;
    margin-bottom: 3rem;
  }
  
  @media screen and (min-width: 750px) {
    .footer__content {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  .footer__section h3 {
    color: var(--color-base-background-1);
    margin-bottom: 2rem;
    font-size: 1.8rem;
  }
  
  .footer__section p {
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
  
  .footer__section nav {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  .footer__section a {
    color: var(--color-base-background-1);
    text-decoration: none;
    transition: opacity 0.3s ease;
  }
  
  .footer__section a:hover {
    opacity: 0.8;
    text-decoration: underline;
  }
  
  .social-icons {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  
  .social-icon {
    display: inline-block;
    color: var(--color-base-background-1);
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  
  .social-icon:hover {
    transform: scale(1.1);
    opacity: 0.8;
    text-decoration: none;
  }
  
  .footer-newsletter {
    margin-top: 2rem;
  }
  
  .footer-newsletter .newsletter__input {
    background-color: var(--color-base-background-1);
    color: var(--color-base-text);
    border: 1px solid rgba(255, 255, 255, 0.3);
    margin-bottom: 1rem;
  }
  
  .footer-newsletter .btn {
    background-color: var(--color-base-background-1);
    color: var(--color-base-accent-1);
    border-color: var(--color-base-background-1);
  }
  
  .footer-newsletter .btn:hover {
    opacity: 0.9;
  }
  
  .footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 2rem;
    text-align: center;
    color: rgba(255, 255, 255, 0.7);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }
  
  @media screen and (min-width: 750px) {
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }
  
  .payment-icons {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  
  .payment-icon {
    height: 2rem;
    width: auto;
    opacity: 0.7;
  }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "About section"
    },
    {
      "type": "text",
      "id": "about_title",
      "label": "About title",
      "default": "About The Shade 4cast"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About text",
      "default": "Your go-to 4-person panel talk show covering politics and hot topics with insight, humor, and a whole lot of shade."
    },
    {
      "type": "header",
      "content": "Social media"
    },
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "Show social media icons",
      "default": true
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "Twitter URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter title",
      "default": "Stay in the Loop"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "Subscribe to our newsletter for the latest updates and behind-the-scenes content."
    },
    {
      "type": "header",
      "content": "Payment"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ]
}
{% endschema %}