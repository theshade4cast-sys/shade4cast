{% comment %}
  Hosts grid section for about page
{% endcomment %}

<section class="section">
  <div class="container">
    {% if section.settings.title != blank %}
      <div class="section-header">
        <h2>{{ section.settings.title }}</h2>
        {% if section.settings.subtitle != blank %}
          <p>{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}
    
    {% if section.blocks.size > 0 %}
      <div class="hosts-grid">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'host' %}
              <div class="host-card" {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}
                  <div class="host-card__image">
                    <img src="{{ block.settings.image | image_url: width: 400 }}" 
                         alt="{{ block.settings.image.alt | default: block.settings.name | escape }}"
                         loading="lazy">
                  </div>
                {% else %}
                  <div class="host-card__placeholder">
                    <svg width="80" height="80" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    </svg>
                  </div>
                {% endif %}
                
                <div class="host-card__content">
                  {% if block.settings.name != blank %}
                    <h3 class="host-card__name">{{ block.settings.name }}</h3>
                  {% endif %}
                  
                  {% if block.settings.title != blank %}
                    <p class="host-card__title">{{ block.settings.title }}</p>
                  {% endif %}
                  
                  {% if block.settings.bio != blank %}
                    <div class="host-card__bio">
                      {{ block.settings.bio }}
                    </div>
                  {% endif %}
                  
                  {% if block.settings.social_twitter != blank or block.settings.social_instagram != blank %}
                    <div class="host-card__social">
                      {% if block.settings.social_twitter != blank %}
                        <a href="{{ block.settings.social_twitter }}" 
                           target="_blank" 
                           rel="noopener noreferrer"
                           class="host-card__social-link"
                           aria-label="Twitter">
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                          </svg>
                        </a>
                      {% endif %}
                      
                      {% if block.settings.social_instagram != blank %}
                        <a href="{{ block.settings.social_instagram }}" 
                           target="_blank" 
                           rel="noopener noreferrer"
                           class="host-card__social-link"
                           aria-label="Instagram">
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                          </svg>
                        </a>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    {% else %}
      <div class="placeholder-hosts">
        <div class="hosts-grid">
          {% for i in (1..4) %}
            <div class="host-card">
              <div class="host-card__placeholder">
                <svg width="80" height="80" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </svg>
              </div>
              <div class="host-card__content">
                <h3 class="host-card__name">Host {{ i }}</h3>
                <p class="host-card__title">Panel Member</p>
                <div class="host-card__bio">
                  <p>Add host information and bio here. This is where you'll showcase each panel member's expertise and personality.</p>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .hosts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(28rem, 1fr));
    gap: 4rem;
  }
  
  .host-card {
    background-color: var(--color-base-background-1);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: var(--media-radius);
    overflow: hidden;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .host-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
  }
  
  .host-card__image {
    width: 100%;
    height: 30rem;
    overflow: hidden;
  }
  
  .host-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .host-card__placeholder {
    width: 100%;
    height: 30rem;
    background-color: var(--color-base-background-2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-base-accent-2);
  }
  
  .host-card__content {
    padding: 3rem 2rem;
  }
  
  .host-card__name {
    font-size: 2.4rem;
    margin-bottom: 0.5rem;
    color: var(--color-base-text);
  }
  
  .host-card__title {
    font-size: 1.6rem;
    color: var(--color-base-accent-2);
    font-weight: 600;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  
  .host-card__bio {
    font-size: 1.5rem;
    line-height: 1.6;
    color: var(--color-base-accent-2);
    margin-bottom: 2rem;
  }
  
  .host-card__social {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
  }
  
  .host-card__social-link {
    color: var(--color-base-accent-2);
    transition: color 0.3s ease, transform 0.3s ease;
  }
  
  .host-card__social-link:hover {
    color: var(--color-base-accent-1);
    transform: scale(1.1);
  }
  
  @media screen and (max-width: 749px) {
    .hosts-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>

{% schema %}
{
  "name": "Hosts Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Meet Our Hosts"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section subtitle"
    }
  ],
  "blocks": [
    {
      "type": "host",
      "name": "Host",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Host photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Host name"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Host title/role"
        },
        {
          "type": "richtext",
          "id": "bio",
          "label": "Host bio"
        },
        {
          "type": "url",
          "id": "social_twitter",
          "label": "Twitter URL"
        },
        {
          "type": "url",
          "id": "social_instagram",
          "label": "Instagram URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hosts Grid"
    }
  ]
}
{% endschema %}