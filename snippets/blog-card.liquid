{% comment %}
  Blog card snippet for displaying blog articles in grids
  
  Accepts:
  - article: article object
  - show_author: boolean (optional)
  - show_date: boolean (optional, default: true)
  - show_excerpt: boolean (optional, default: true)

  Usage:
  {% render 'blog-card', article: article %}
{% endcomment %}

{%- liquid
  assign show_author = show_author | default: false
  assign show_date = show_date | default: true
  assign show_excerpt = show_excerpt | default: true
-%}

<div class="blog-card">
  <div class="blog-card__media">
    {% if article.image %}
      <a href="{{ article.url }}" class="blog-card__media-link">
        <img srcset="{%- if article.image.width >= 165 -%}{{ article.image | image_url: width: 165 }} 165w,{%- endif -%}
                     {%- if article.image.width >= 360 -%}{{ article.image | image_url: width: 360 }} 360w,{%- endif -%}
                     {%- if article.image.width >= 533 -%}{{ article.image | image_url: width: 533 }} 533w,{%- endif -%}
                     {%- if article.image.width >= 720 -%}{{ article.image | image_url: width: 720 }} 720w,{%- endif -%}
                     {%- if article.image.width >= 940 -%}{{ article.image | image_url: width: 940 }} 940w,{%- endif -%}
                     {%- if article.image.width >= 1066 -%}{{ article.image | image_url: width: 1066 }} 1066w,{%- endif -%}
                     {{ article.image | image_url }} {{ article.image.width }}w"
             src="{{ article.image | image_url: width: 533 }}"
             sizes="(min-width: 1100px) 535px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)"
             alt="{{ article.image.alt | escape }}"
             class="blog-card__image"
             loading="lazy"
             width="{{ article.image.width }}"
             height="{{ article.image.height }}">
      </a>
    {% else %}
      <div class="blog-card__media-placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {% endif %}
  </div>
  
  <div class="blog-card__content">
    {% if show_date and article.published_at %}
      <time class="blog-card__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
        {{ article.published_at | date: '%B %d, %Y' }}
      </time>
    {% endif %}
    
    <h3 class="blog-card__title">
      <a href="{{ article.url }}" class="blog-card__title-link">
        {{ article.title | truncate: 60 }}
      </a>
    </h3>
    
    {% if show_author and article.author != blank %}
      <div class="blog-card__author">
        by {{ article.author }}
      </div>
    {% endif %}
    
    {% if show_excerpt and article.excerpt != blank %}
      <div class="blog-card__excerpt">
        {{ article.excerpt | strip_html | truncate: 120 }}
      </div>
    {% elsif show_excerpt and article.content != blank %}
      <div class="blog-card__excerpt">
        {{ article.content | strip_html | truncate: 120 }}
      </div>
    {% endif %}
    
    {% if article.tags.size > 0 %}
      <div class="blog-card__tags">
        {% for tag in article.tags limit: 3 %}
          <span class="blog-card__tag">{{ tag }}</span>
        {% endfor %}
      </div>
    {% endif %}
    
    <div class="blog-card__footer">
      <a href="{{ article.url }}" class="blog-card__read-more">
        Read More
      </a>
    </div>
  </div>
</div>

<style>
  .blog-card {
    background-color: var(--color-base-background-1);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: var(--blog-card-corner-radius);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  
  .blog-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }
  
  .blog-card__media {
    overflow: hidden;
  }
  
  .blog-card__media-link {
    display: block;
  }
  
  .blog-card__image {
    width: 100%;
    height: 20rem;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  
  .blog-card:hover .blog-card__image {
    transform: scale(1.05);
  }
  
  .blog-card__media-placeholder {
    height: 20rem;
    background-color: var(--color-base-background-2);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .blog-card__content {
    padding: 2rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .blog-card__date {
    font-size: 1.4rem;
    color: var(--color-base-accent-2);
    margin-bottom: 1rem;
    display: block;
  }
  
  .blog-card__title {
    font-size: 2rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  
  .blog-card__title-link {
    color: var(--color-base-text);
    text-decoration: none;
  }
  
  .blog-card__title-link:hover {
    color: var(--color-base-accent-2);
  }
  
  .blog-card__author {
    font-size: 1.4rem;
    color: var(--color-base-accent-2);
    margin-bottom: 1rem;
    font-style: italic;
  }
  
  .blog-card__excerpt {
    color: var(--color-base-accent-2);
    margin-bottom: 1.5rem;
    line-height: 1.5;
    flex: 1;
  }
  
  .blog-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  
  .blog-card__tag {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    font-size: 1.2rem;
    background-color: var(--color-base-background-2);
    color: var(--color-base-accent-2);
    border-radius: 2rem;
    text-transform: lowercase;
  }
  
  .blog-card__footer {
    margin-top: auto;
  }
  
  .blog-card__read-more {
    display: inline-block;
    font-weight: 600;
    color: var(--color-link);
    text-decoration: none;
    transition: color 0.3s ease;
  }
  
  .blog-card__read-more:hover {
    color: var(--color-link-hover);
    text-decoration: underline;
  }
  
  .blog-card__read-more::after {
    content: ' →';
    transition: transform 0.3s ease;
  }
  
  .blog-card__read-more:hover::after {
    transform: translateX(3px);
  }
</style>