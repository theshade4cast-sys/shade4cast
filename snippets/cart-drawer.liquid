{% comment %}
  Cart drawer component
{% endcomment %}

<div class="cart-drawer" id="cart-drawer">
  <div class="cart-drawer__overlay"></div>
  <div class="cart-drawer__content">
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">Your Cart</h2>
      <button class="cart-drawer__close" aria-label="Close cart">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
      </button>
    </div>
    
    <div class="cart-drawer__body">
      <div class="cart-drawer__items" id="cart-drawer-items">
        {% if cart.item_count > 0 %}
          {% for item in cart.items %}
            <div class="cart-item" data-line="{{ forloop.index }}">
              <div class="cart-item__image">
                {% if item.image %}
                  <img src="{{ item.image | image_url: width: 100 }}" 
                       alt="{{ item.image.alt | escape }}"
                       loading="lazy">
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'cart-item__placeholder' }}
                {% endif %}
              </div>
              
              <div class="cart-item__details">
                <h3 class="cart-item__title">
                  <a href="{{ item.url }}">{{ item.product.title }}</a>
                </h3>
                
                {% unless item.variant.title == 'Default Title' %}
                  <div class="cart-item__variant">{{ item.variant.title }}</div>
                {% endunless %}
                
                <div class="cart-item__price">
                  {% if item.original_price != item.final_price %}
                    <span class="cart-item__price--sale">{{ item.final_price | money }}</span>
                    <span class="cart-item__price--original">{{ item.original_price | money }}</span>
                  {% else %}
                    <span class="cart-item__price--regular">{{ item.final_price | money }}</span>
                  {% endif %}
                </div>
                
                <div class="cart-item__quantity">
                  <button class="cart-item__qty-btn cart-item__qty-btn--minus" 
                          data-line="{{ forloop.index }}"
                          data-action="decrease"
                          aria-label="Decrease quantity">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M19 13H5v-2h14v2z"/>
                    </svg>
                  </button>
                  
                  <input type="number" 
                         class="cart-item__qty-input"
                         data-line="{{ forloop.index }}"
                         value="{{ item.quantity }}"
                         min="0"
                         aria-label="Quantity">
                  
                  <button class="cart-item__qty-btn cart-item__qty-btn--plus" 
                          data-line="{{ forloop.index }}"
                          data-action="increase"
                          aria-label="Increase quantity">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                    </svg>
                  </button>
                </div>
                
                <button class="cart-item__remove" 
                        data-line="{{ forloop.index }}"
                        aria-label="Remove item">
                  Remove
                </button>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <div class="cart-drawer__empty">
            <svg width="60" height="60" viewBox="0 0 24 24" fill="currentColor">
              <path d="M7 18c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12L8.1 13h7.45c.75 0 1.41-.41 1.75-1.03L21.7 4H5.21l-.94-2H1zm16 16c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
            </svg>
            <h3>Your cart is empty</h3>
            <p>Add some items to get started</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn">Continue Shopping</a>
          </div>
        {% endif %}
      </div>
    </div>
    
    {% if cart.item_count > 0 %}
      <div class="cart-drawer__footer">
        <div class="cart-drawer__totals">
          <div class="cart-total">
            <span class="cart-total__label">Subtotal:</span>
            <span class="cart-total__price" id="cart-total">{{ cart.total_price | money }}</span>
          </div>
          
          {% if cart.cart_level_discount_applications.size > 0 %}
            <div class="cart-discounts">
              {% for discount in cart.cart_level_discount_applications %}
                <div class="cart-discount">
                  <span class="cart-discount__label">{{ discount.title }}:</span>
                  <span class="cart-discount__amount">-{{ discount.total_allocated_amount | money }}</span>
                </div>
              {% endfor %}
            </div>
          {% endif %}
          
          <p class="cart-drawer__note">Shipping and taxes calculated at checkout</p>
        </div>
        
        <div class="cart-drawer__actions">
          <a href="{{ routes.cart_url }}" class="btn btn--secondary cart-drawer__view-cart">
            View Cart
          </a>
          <button type="submit" class="btn checkout-btn" name="add" form="cart-form">
            Checkout
          </button>
        </div>
      </div>
    {% endif %}
  </div>
</div>

<style>
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1000;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .cart-drawer.is-open {
    pointer-events: auto;
    opacity: 1;
  }
  
  .cart-drawer__overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .cart-drawer.is-open .cart-drawer__overlay {
    opacity: 1;
  }
  
  .cart-drawer__content {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 40rem;
    background-color: var(--color-base-background-1);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    box-shadow: -4px 0 20px rgba(0, 0, 0, 0.1);
  }
  
  .cart-drawer.is-open .cart-drawer__content {
    transform: translateX(0);
  }
  
  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }
  
  .cart-drawer__title {
    font-size: 2rem;
    margin: 0;
  }
  
  .cart-drawer__close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    color: var(--color-base-text);
  }
  
  .cart-drawer__close:hover {
    color: var(--color-base-accent-2);
  }
  
  .cart-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 2rem;
  }
  
  .cart-drawer__empty {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--color-base-accent-2);
  }
  
  .cart-drawer__empty svg {
    margin-bottom: 2rem;
  }
  
  .cart-drawer__empty h3 {
    margin-bottom: 1rem;
    color: var(--color-base-text);
  }
  
  .cart-drawer__empty p {
    margin-bottom: 3rem;
  }
  
  .cart-item {
    display: flex;
    gap: 1.5rem;
    padding-bottom: 2rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }
  
  .cart-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
  }
  
  .cart-item__image {
    flex-shrink: 0;
    width: 8rem;
    height: 8rem;
    border-radius: 4px;
    overflow: hidden;
  }
  
  .cart-item__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .cart-item__placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-base-background-2);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .cart-item__details {
    flex: 1;
    min-width: 0;
  }
  
  .cart-item__title {
    font-size: 1.6rem;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }
  
  .cart-item__title a {
    color: var(--color-base-text);
    text-decoration: none;
  }
  
  .cart-item__title a:hover {
    color: var(--color-base-accent-1);
    text-decoration: underline;
  }
  
  .cart-item__variant {
    font-size: 1.4rem;
    color: var(--color-base-accent-2);
    margin-bottom: 1rem;
  }
  
  .cart-item__price {
    margin-bottom: 1rem;
  }
  
  .cart-item__price--sale {
    color: #dc2626;
    font-weight: 600;
    margin-right: 0.5rem;
  }
  
  .cart-item__price--original {
    text-decoration: line-through;
    color: var(--color-base-accent-2);
    font-size: 1.4rem;
  }
  
  .cart-item__price--regular {
    font-weight: 600;
  }
  
  .cart-item__quantity {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  
  .cart-item__qty-btn {
    background: none;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.3s ease;
  }
  
  .cart-item__qty-btn:hover {
    border-color: var(--color-base-accent-1);
  }
  
  .cart-item__qty-input {
    width: 5rem;
    padding: 0.5rem;
    text-align: center;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    font-size: 1.4rem;
  }
  
  .cart-item__remove {
    background: none;
    border: none;
    color: var(--color-base-accent-2);
    cursor: pointer;
    font-size: 1.3rem;
    text-decoration: underline;
  }
  
  .cart-item__remove:hover {
    color: #dc2626;
  }
  
  .cart-drawer__footer {
    padding: 2rem;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }
  
  .cart-drawer__totals {
    margin-bottom: 2rem;
  }
  
  .cart-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  
  .cart-total__label {
    font-size: 1.6rem;
    font-weight: 600;
  }
  
  .cart-total__price {
    font-size: 1.8rem;
    font-weight: bold;
    color: var(--color-base-accent-1);
  }
  
  .cart-discounts {
    margin-bottom: 1rem;
  }
  
  .cart-discount {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 1.4rem;
    color: var(--color-base-accent-2);
    margin-bottom: 0.5rem;
  }
  
  .cart-discount__amount {
    color: #10b981;
    font-weight: 600;
  }
  
  .cart-drawer__note {
    font-size: 1.3rem;
    color: var(--color-base-accent-2);
    margin: 0;
  }
  
  .cart-drawer__actions {
    display: flex;
    gap: 1rem;
  }
  
  .cart-drawer__view-cart {
    flex: 1;
  }
  
  .checkout-btn {
    flex: 2;
  }
  
  @media screen and (max-width: 749px) {
    .cart-drawer__content {
      max-width: 100%;
    }
    
    .cart-drawer__actions {
      flex-direction: column;
    }
    
    .cart-drawer__view-cart,
    .checkout-btn {
      flex: 1;
    }
  }
</style>