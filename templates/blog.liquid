{% comment %}
  Blog template for "Shady Topics"
{% endcomment %}

<div class="container">
  <div class="section">
    <div class="section-header">
      <h1>{{ blog.title }}</h1>
      {% if blog.summary != blank %}
        <p>{{ blog.summary }}</p>
      {% endif %}
    </div>
    
    {% paginate blog.articles by 6 %}
      <div class="blog-grid">
        {% for article in blog.articles %}
          {% render 'blog-card', article: article %}
        {% endfor %}
      </div>
      
      {% if paginate.pages > 1 %}
        {% render 'pagination', paginate: paginate %}
      {% endif %}
    {% endpaginate %}
  </div>
</div>