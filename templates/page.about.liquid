{% comment %}
  About page template for The Shade 4cast hosts
{% endcomment %}

<div class="container">
  <div class="section">
    <div class="section-header">
      <h1>{{ page.title }}</h1>
      {% if page.content != blank %}
        <div class="rte">
          {{ page.content }}
        </div>
      {% endif %}
    </div>
    
    {% section 'hosts-grid' %}
  </div>
</div>