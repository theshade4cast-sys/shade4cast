{% comment %}
  Default page template
{% endcomment %}

<div class="container">
  <div class="section">
    <div class="section-header">
      <h1>{{ page.title }}</h1>
    </div>
    
    {% if page.content != blank %}
      <div class="rte">
        {{ page.content }}
      </div>
    {% endif %}
  </div>
</div>