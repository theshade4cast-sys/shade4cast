{% comment %}
  Videos page template for displaying latest YouTube videos
{% endcomment %}

<div class="container">
  <div class="section">
    <div class="section-header">
      <h1>{{ page.title | default: "Latest Videos" }}</h1>
      {% if page.content != blank %}
        <div class="rte">
          {{ page.content }}
        </div>
      {% endif %}
    </div>
    
    {% section 'youtube-videos-grid' %}
  </div>
</div>